# CountOrSell - Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# For local development, place .env in src/CountOrSell.Api/ (loaded by dotenv).
# For Docker Compose, place .env alongside docker-compose.yml or in the repo root.

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------

# HTTP port the application listens on (default: 3000)
PORT=3000

# Instance branding text displayed in the header and browser tab
INSTANCE_NAME=CountOrSell

# Canonical public origin for outbound links (e.g. invite emails).
# When unset, falls back to the incoming Host header.
# PUBLIC_BASE_URL=https://app.example.com

# --------------------------------------------------------------------------
# Database (individual variables - recommended)
# --------------------------------------------------------------------------

# PostgreSQL host (default: localhost)
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name (default: countorsell)
DB_NAME=countorsell

# Database username (required)
DB_USER=

# Database password (required)
DB_PASSWORD=

# --------------------------------------------------------------------------
# Database (full connection string - overrides individual variables above)
# --------------------------------------------------------------------------

# Full Npgsql connection string. When set, DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are ignored.
# POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=countorsell;Username=myuser;Password=mypass

# --------------------------------------------------------------------------
# Content Updates
# --------------------------------------------------------------------------

# Daily update check time in HH:MM format (generated by wizard)
UPDATE_CHECK_TIME=04:00

# --------------------------------------------------------------------------
# Backup
# --------------------------------------------------------------------------

# Cron expression for scheduled backups (default: weekly Sunday at 2 AM)
BACKUP_SCHEDULE=0 2 * * 0

# Number of backups to retain per type (default: 4)
BACKUP_RETENTION=4

# Primary backup destination connection string
# BLOB_BACKUP_CONNECTION=

# Local backup file path (default: relative to app directory in dev, /app/data/backups in container)
# BACKUP_LOCAL_PATH=./backups

# --------------------------------------------------------------------------
# Image Storage
# --------------------------------------------------------------------------

# Base path for card and sealed product images
# (default: relative to app directory; set to /app/data/images in container)
# ImageStore__BasePath=./images

# --------------------------------------------------------------------------
# TCGPlayer (optional)
# --------------------------------------------------------------------------

# TCGPlayer API key for direct price queries. Not required.
# TCGPLAYER_API_KEY=

# --------------------------------------------------------------------------
# Demo Mode (optional)
# --------------------------------------------------------------------------

# Set to "true" to activate demo mode
# DEMO_MODE=false

# ISO 8601 expiry datetime for demo countdown clock
# DEMO_EXPIRES_AT=

# --------------------------------------------------------------------------
# OAuth Providers (optional, configured post-setup via admin UI)
# These are read from the app_settings database table at startup.
# Set here only if you need to bootstrap OAuth before the admin UI is available.
# --------------------------------------------------------------------------

# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFTENTRA_CLIENT_ID=
# OAUTH_MICROSOFTENTRA_CLIENT_SECRET=
# OAUTH_MICROSOFTENTRA_TENANT_ID=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Cloud Provider (set by Terraform, not manually configured)
# --------------------------------------------------------------------------

# CLOUD_PROVIDER=               # "azure", "aws", "gcp", or absent for Docker
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# AZURE_APP_NAME=
# CLOUD_APP_RUNNER_SERVICE_NAME=
# CLOUD_REGION=
# CLOUD_ECR_REGISTRY=
# GCP_PROJECT_ID=
# GCP_REGION=
# GCP_SERVICE_NAME=

# --------------------------------------------------------------------------
# Docker Compose Only
# --------------------------------------------------------------------------

# Full image reference for the app container (default: ghcr.io/darkgrotto/countorsell:latest)
# Override to use a different registry, org, or tag.
# APP_IMAGE=ghcr.io/darkgrotto/countorsell:latest

# Application version updates are operator-driven: when the admin is notified
# in-app of a new release, run docker/scripts/update.sh on the host to pull and
# recreate the app container. There is no in-container auto-updater by design.
