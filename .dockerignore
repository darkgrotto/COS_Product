# Infrastructure and CI - not needed in image
infrastructure/
.github/

# Generated Docker Compose files, certificates, and scripts - not needed in image
docker/compose/
docker/certs/
docker-compose*.yml
scripts/

# Local configuration and secrets - must never be in any image layer
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Build artifacts - rebuilt inside Docker.
# node_modules must never enter the context: it lands after the npm ci layer and
# would overwrite the container's install with a host-architecture tree.
# Matched by wildcard rather than a fixed path so a project move cannot silently
# stop excluding it (the previous src/Client/... paths matched nothing).
src/**/bin/
src/**/obj/
**/node_modules/
src/CountOrSell.Api/Client/dist/

# Local test and developer files
docker/test/

# Git metadata
.git/
.gitignore
.gitattributes

# Documentation
*.md
LICENSE
